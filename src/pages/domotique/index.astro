---
import Badge from "../../components/Badge.astro";
import CollectionListItem from "../../components/CollectionListItem.astro";
import PageHeader from "../../components/PageHeader.astro";
import Layout from "../../layouts/Layout.astro";
import {
  formatDateFr,
  getPublishedCollection,
  getTagColor,
  sortByDateDesc,
} from "../../lib/content";
import { getThumbnail } from "../../lib/images";

const domotiques = sortByDateDesc(await getPublishedCollection("domotiques"));
const domotiquesWithImages = await Promise.all(
  domotiques.map(async (domotique) => ({
    domotique,
    img: await getThumbnail("domotiques", domotique),
  }))
);
---

<Layout title="Domotique">
  <PageHeader title="Domotique" count={domotiques.length} />

  <div class="divide-y divide-[#d0d7de]">
    {
      domotiquesWithImages.map(({ domotique, img }) => {
        return (
          <CollectionListItem
            href={`/domotique/${domotique.id}`}
            title={domotique.data.title}
            description={domotique.data.description}
            thumbnail={img ?? undefined}
          >
            <div slot="meta" class="w-full flex flex-col gap-1">
              <div class="flex flex-wrap items-center gap-1.5">
                {domotique.data.tags?.map((tag) => (
                  <span class="flex items-center gap-1.5">
                    <span class={`w-2.5 h-2.5 rounded-full ${getTagColor(tag)}`} />
                    {tag}
                  </span>
                ))}
              </div>
              <div class="w-full flex justify-end">
                <span class="text-xs font-bold text-[#57606a] whitespace-nowrap">
                  {formatDateFr(domotique.data.date)}
                </span>
              </div>
            </div>
          </CollectionListItem>
        );
      })
    }
  </div>
</Layout>
