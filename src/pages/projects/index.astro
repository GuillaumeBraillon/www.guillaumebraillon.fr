---
import Badge from "../../components/Badge.astro";
import CollectionListItem from "../../components/CollectionListItem.astro";
import PageHeader from "../../components/PageHeader.astro";
import Layout from "../../layouts/Layout.astro";
import {
  formatDateFr,
  getPublishedCollection,
  getTagColor,
  sortByDateDesc,
} from "../../lib/content";
import { getThumbnail } from "../../lib/images";

const projects = sortByDateDesc(await getPublishedCollection("projects"));
const projectsWithImages = await Promise.all(
  projects.map(async (project) => ({
    project,
    img: await getThumbnail("projects", project),
  }))
);
---

<Layout title="Projets & créations">
  <PageHeader title="Projets & créations" count={projects.length} />

  <div class="divide-y divide-[#d0d7de]">
    {
      projectsWithImages.map(({ project, img }) => {
        return (
          <CollectionListItem
            href={`/projects/${project.id}`}
            title={project.data.title}
            description={project.data.description}
            thumbnail={img ?? undefined}
            thumbnailAlt={project.data.title}
          >
            <Badge
              slot="titleBadge"
              variant={project.data.status === "Public" ? "public" : "private"}
            >
              {project.data.status ?? "Privé"}
            </Badge>
            <div slot="meta" class="w-full flex flex-col gap-1">
              <div class="flex flex-wrap items-center gap-1.5">
                {project.data.tech?.map((tag) => (
                  <span class="flex items-center gap-1.5">
                    <span class={`w-2.5 h-2.5 rounded-full ${getTagColor(tag)}`} />
                    {tag}
                  </span>
                ))}
              </div>
              <div class="w-full flex justify-end">
                <span class="text-xs font-bold text-[#57606a] whitespace-nowrap">
                  {formatDateFr(project.data.date)}
                </span>
              </div>
            </div>
          </CollectionListItem>
        );
      })
    }
  </div>
</Layout>
