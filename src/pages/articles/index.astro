---
import CollectionListItem from "../../components/CollectionListItem.astro";
import PageHeader from "../../components/PageHeader.astro";
import Layout from "../../layouts/Layout.astro";
import {
  formatDateFr,
  getPublishedCollection,
  getTagColor,
  sortByDateDesc,
} from "../../lib/content";
import { getThumbnail } from "../../lib/images";

const articles = sortByDateDesc(await getPublishedCollection("articles"));
const articlesWithImages = await Promise.all(
  articles.map(async (article) => ({
    article,
    img: await getThumbnail("articles", article),
  }))
);
---

<Layout title="Articles">
  <PageHeader title="Articles" count={articles.length} />

  <div class="divide-y divide-[#d0d7de]">
    {
      articlesWithImages.map(({ article, img }) => {
        return (
          <CollectionListItem
            href={`/articles/${article.id}`}
            title={article.data.title}
            description={article.data.description}
            thumbnail={img ?? undefined}
            thumbnailAlt={article.data.title}
          >
            <div slot="meta" class="w-full flex flex-col gap-1">
              <div class="flex flex-wrap items-center gap-1.5">
                {article.data.tags?.map((tag) => (
                  <span class="flex items-center gap-1.5">
                    <span class={`w-2.5 h-2.5 rounded-full ${getTagColor(tag)}`} />
                    {tag}
                  </span>
                ))}
              </div>
              <div class="w-full flex justify-end">
                <span class="text-xs font-bold text-[#57606a] whitespace-nowrap">
                  {formatDateFr(article.data.date)}
                </span>
              </div>
            </div>
          </CollectionListItem>
        );
      })
    }
  </div>
</Layout>
