---
import Badge from "../components/Badge.astro";
import Button from "../components/Button.astro";
import HomeProjectCard from "../components/HomeProjectCard.astro";
import HomeSidebarItem from "../components/HomeSidebarItem.astro";
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { formatDateFr, getPublishedCollection, getTagColor, sortByDateDesc } from "../lib/content";
import { getThumbnail } from "../lib/images";
import tablaturesData from "../data/tablatures.json";

// Sélection des tablatures
const targetNames = [
  "Special - Jack Johnson Songs By Guillaume Braillon.pdf",
  "Jean Jacques Goldman - On Ira.pdf",
  "Queen - I Want To Break Free.pdf",
  "AaRON - U-Turn Lili.pdf",
  "Alexandre Kinn - Aude.pdf",
  "Eric Clapton - Change The World.pdf",
  "Eric Clapton - Nobody Knows You When Youre Down And Out (Unplugged).pdf",
  "Graeme Allwright - Jusqu'a  La Ceinture.pdf",
  "Kaolin - Partons Vite.pdf",
  "Keb Mo - Loola Loo1.pdf",
  "Lilicub - Voyage En Italie.pdf",
  "Paul Personne - Encore A L'essai.pdf",
  "Renaud - Mistral Gagnant.pdf",
  "Serge Gainsbourg - Je Suis Venu Te Dire Que Je M'en Vais.pdf",
  "Telephone - Cendrillon.pdf",
  "Waifs (The) - Haircut.pdf",
  "Waifs (The) - London Still.pdf",
];

// Tri des projets par date décroissante et sélection des 5 plus récents
const projects = sortByDateDesc(await getPublishedCollection("projects")).slice(0, 5);
// Mélange aléatoire et sélection de 5 articles domotiques
const recentDomotiques = [...(await getPublishedCollection("domotiques"))]
  .sort(() => Math.random() - 0.5)
  .slice(0, 5);

// Mélange aléatoire et sélection de 10 tablatures parmi les tablatures mises en avant
const featuredTablatures = tablaturesData
  .filter((tab) => targetNames.includes(tab.name))
  .sort(() => Math.random() - 0.5)
  .slice(0, 10);

// Tri des collections par date décroissante et sélection des 5 plus récentes
const recentVoyages = sortByDateDesc(await getPublishedCollection("voyages")).slice(0, 5);
// Tri des collections par date décroissante et sélection des 5 plus récentes
const recentArticles = sortByDateDesc(await getPublishedCollection("articles")).slice(0, 5);

// Récupération des images pour les projets, domotiques, articles et voyages
const projectsWithImages = await Promise.all(
  projects.map(async (item) => ({
    item,
    img: await getThumbnail("projects", item),
  }))
);

const recentDomotiquesWithImages = await Promise.all(
  recentDomotiques.map(async (item) => ({
    item,
    img: await getThumbnail("domotiques", item),
  }))
);

const recentArticlesWithImages = await Promise.all(
  recentArticles.map(async (item) => ({
    item,
    img: await getThumbnail("articles", item),
  }))
);

const recentVoyagesWithImages = await Promise.all(
  recentVoyages.map(async (item) => ({
    item,
    img: await getThumbnail("voyages", item),
  }))
);
---

<Layout>
  <section class="pb-6 mb-6 border-b border-[#d0d7de]">
    <div class="flex flex-col">
      <div>
        <h1 class="text-2xl font-semibold text-[#1f2328] tracking-tight">
          {site.tagline}
        </h1>
        <div class="mt-1">
          <Badge variant="home">{site.home.badge}</Badge>
        </div>
        <p class="mt-2 text-[14px] text-[#57606a] leading-relaxed">
          {site.home.description}
        </p>
      </div>

      <div class="flex justify-end">
        <Button href="/cv" variant="primary"> Mon CV </Button>
      </div>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <section class="border border-[#d0d7de] rounded-md bg-white overflow-hidden">
        <div
          class="bg-[#f6f8fa] border-b border-[#d0d7de] px-4 py-2 flex items-center justify-between"
        >
          <span class="text-xs font-semibold text-[#1f2328]">Projets & créations</span>
          <a href="/projects" class="text-[11px] text-[#0969da] hover:underline">Voir tout</a>
        </div>
        <div class="grid gap-3 p-3">
          {
            projectsWithImages.length > 0 ? (
              projectsWithImages.map(({ item: project, img }) => {
                return (
                  <HomeProjectCard
                    href={`/projects/${project.id}`}
                    title={project.data.title}
                    description={project.data.description}
                    thumbnail={img ?? undefined}
                    variant="compact"
                  >
                    {project.data.tech &&
                      project.data.tech.map((tech) => (
                        <span slot="meta" class="flex items-center gap-1.5">
                          <span class={`w-2.5 h-2.5 rounded-full ${getTagColor(tech)}`} />
                          {tech}
                        </span>
                      ))}
                  </HomeProjectCard>
                );
              })
            ) : (
              <p class="text-xs text-[#636c76] col-span-2">Aucun autre projet à afficher.</p>
            )
          }
        </div>
      </section>

      <section class="border border-[#d0d7de] rounded-md bg-white overflow-hidden">
        <div
          class="bg-[#f6f8fa] border-b border-[#d0d7de] px-4 py-2 flex items-center justify-between"
        >
          <span class="text-xs font-semibold text-[#1f2328]">Articles domotiques (aléatoires)</span>
          <a href="/domotique" class="text-[11px] text-[#0969da] hover:underline">Voir tout</a>
        </div>
        <div class="grid gap-3 p-3">
          {
            recentDomotiquesWithImages.length > 0 ? (
              recentDomotiquesWithImages.map(({ item, img }) => {
                return (
                  <HomeProjectCard
                    href={`/domotique/${item.id}`}
                    title={item.data.title}
                    description={item.data.description}
                    thumbnail={img ?? undefined}
                    variant="compact"
                  >
                    <div slot="meta" class="w-full flex flex-col gap-1">
                      <div class="flex flex-wrap items-center gap-1.5">
                        {item.data.tags?.map((tag) => (
                          <span class="flex items-center gap-1.5">
                            <span class={`w-2.5 h-2.5 rounded-full ${getTagColor(tag)}`} />
                            {tag}
                          </span>
                        ))}
                      </div>
                      <div class="w-full flex justify-end">
                        <span class="text-xs font-bold text-[#57606a] whitespace-nowrap">
                          {formatDateFr(item.data.date)}
                        </span>
                      </div>
                    </div>
                  </HomeProjectCard>
                );
              })
            ) : (
              <p class="text-xs text-[#636c76] col-span-2">
                Aucun autre article domotique à afficher.
              </p>
            )
          }
        </div>
      </section>
    </div>

    <div class="space-y-6">
      {
        recentArticlesWithImages.length > 0 && (
          <section class="border border-[#d0d7de] rounded-md bg-white overflow-hidden">
            <div class="bg-[#f6f8fa] border-b border-[#d0d7de] px-4 py-2 flex items-center justify-between">
              <span class="text-xs font-semibold text-[#1f2328]">Derniers articles</span>
              <a href="/articles" class="text-[11px] text-[#0969da] hover:underline">
                Voir tout
              </a>
            </div>
            <div class="divide-y divide-[#d0d7de]">
              {recentArticlesWithImages.map(({ item, img }) => (
                <HomeSidebarItem
                  href={`/articles/${item.id}`}
                  title={item.data.title}
                  thumbnail={img ?? undefined}
                />
              ))}
            </div>
          </section>
        )
      }
      {
        featuredTablatures.length > 0 && (
          <section class="border border-[#d0d7de] rounded-md bg-white overflow-hidden mt-4">
            <div class="bg-[#f6f8fa] border-b border-[#d0d7de] px-4 py-2 flex items-center justify-between">
              <span class="text-xs font-semibold text-[#1f2328]">Tablatures (aléatoires)</span>
              <a href="/tablatures" class="text-[11px] text-[#0969da] hover:underline">
                Voir tout
              </a>
            </div>
            <div class="divide-y divide-[#d0d7de]">
              {featuredTablatures.map((tab) => (
                <HomeSidebarItem
                  href={`/tablatures?path=${encodeURIComponent(tab.path)}`}
                  title={tab.name.replace(/\.[^/.]+$/, "")}
                >
                  <span
                    slot="badge"
                    class="text-[11px] text-[#636c76] bg-[#eaeef2] px-1.5 py-0.5 rounded shrink-0 uppercase font-mono"
                  >
                    {tab.extension}
                  </span>
                </HomeSidebarItem>
              ))}
            </div>
          </section>
        )
      }
      {
        recentVoyagesWithImages.length > 0 && (
          <section class="border border-[#d0d7de] rounded-md bg-white overflow-hidden">
            <div class="bg-[#f6f8fa] border-b border-[#d0d7de] px-4 py-2 flex items-center justify-between">
              <span class="text-xs font-semibold text-[#1f2328]">Derniers voyages</span>
              <a href="/voyages" class="text-[11px] text-[#0969da] hover:underline">
                Voir tout
              </a>
            </div>
            <div class="divide-y divide-[#d0d7de]">
              {recentVoyagesWithImages.map(({ item, img }) => (
                <HomeSidebarItem
                  href={`/voyages/${item.id}`}
                  title={item.data.title}
                  thumbnail={img ?? undefined}
                >
                  <span
                    slot="badge"
                    class="text-[11px] text-[#636c76] bg-[#eaeef2] px-1.5 py-0.5 rounded shrink-0"
                  >
                    {item.data.country}
                  </span>
                </HomeSidebarItem>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </div>
</Layout>
