---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import tablatures from "../../data/tablatures.json";

const lettersSet = [...new Set(tablatures.map((t) => t.letter))].sort();

// build grouped object without reduce
type TabFile = {
  name: string;
  path: string;
  letter: string;
  extension: string;
  index: number;
};

const grouped: Record<string, TabFile[]> = {};
for (const t of tablatures) {
  const letter = t.letter || "#";
  if (!grouped[letter]) grouped[letter] = [];
  grouped[letter].push(t);
}
---

<Layout title="Tablatures">
  <PageHeader title="Tablatures" count={tablatures.length} />

  <!-- Sticky index -->
  <div class="sticky top-0 bg-white/95 backdrop-blur border-b border-[#d0d7de] z-10 py-2">
    <div class="flex flex-wrap gap-2 text-xs">
      {
        lettersSet.map((letter) => (
          <a
            href={`#${letter}`}
            data-letter={letter}
            class="px-2 py-1 border rounded hover:bg-gray-100"
          >
            {letter}
          </a>
        ))
      }
    </div>

    <div class="mt-2 space-y-2">
      <div class="flex gap-2 text-xs">
        <button
          id="mode-hide"
          type="button"
          aria-pressed="true"
          class="px-2 py-1 border rounded bg-gray-100"
        >
          Cacher les autres
        </button>

        <button
          id="mode-highlight"
          type="button"
          aria-pressed="false"
          class="px-2 py-1 border rounded"
        >
          Mettre en évidence
        </button>

        <button
          id="next-match"
          type="button"
          class="bg-black/90 hover:bg-black text-white text-sm px-4 rounded-full shadow-lg border border-white/10 backdrop-blur transition hidden"
        >
          Suivant <span id="match-counter">0 / 0</span>
        </button>
        <div id="hide-counter" class="text-xs text-gray-600 mt-1 hidden"></div>
      </div>

      <div class="relative">
        <input
          id="search"
          type="text"
          placeholder="Rechercher une tablature..."
          class="w-full pr-10 px-3 py-2 border border-[#d0d7de] rounded-md text-sm"
        />

        <button
          id="clear-search"
          type="button"
          class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-500 hover:text-black text-sm"
          aria-label="Effacer la recherche"
        >
          ✕
        </button>
      </div>
    </div>
  </div>

  <!-- Library -->
  <div id="tab-library" class="mt-4 space-y-8">
    {
      Object.keys(grouped)
        .sort()
        .map((letter) => (
          <section id={letter} style="scroll-margin-top: 120px;">
            <h2 class="text-sm font-semibold mb-2 text-gray-700">{letter}</h2>

            <div class="divide-y divide-[#d0d7de]">
              {grouped[letter].map((file) => (
                <div
                  class="flex items-center justify-between tab-item"
                  data-name={file.name.toLowerCase()}
                >
                  <a
                    href={file.path}
                    class="text-sm text-[#0969da] hover:underline"
                    data-original-name={file.name.replace(/\.[^.]+$/, "")}
                    data-path={file.path}
                    data-extension={file.extension.toLowerCase()}
                  >
                    {file.name}
                  </a>

                  <span class="text-xs text-gray-500 uppercase">{file.extension}</span>
                </div>
              ))}
            </div>
          </section>
        ))
    }
  </div>

  <!-- Tab viewer modal -->
  <div
    id="tab-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="tab-modal-title"
  >
    <div
      class="flex max-h-[90vh] w-full max-w-3xl min-w-0 flex-col rounded-md border border-[#d0d7de] bg-white shadow-xl overflow-hidden
         landscape:max-h-full landscape:h-full landscape:w-full landscape:max-w-none landscape:rounded-none landscape:border-none"
    >
      <!-- Header -->
      <div
        class="flex items-center justify-between gap-2 border-b border-[#d0d7de] px-4 py-3 w-full shrink-0 bg-[#f6f8fa]
            landscape:py-1.5 landscape:px-3"
      >
        <h2
          id="tab-modal-title"
          class="truncate text-sm font-semibold text-gray-800 flex-1 min-w-0 landscape:text-xs"
        >
        </h2>

        <div class="flex items-center gap-1 text-xs shrink-0">
          <button
            id="tab-zoom-out"
            type="button"
            class="px-2 py-1 border rounded bg-white hover:bg-gray-100"
            aria-label="Réduire le texte">A-</button
          >
          <button
            id="tab-zoom-in"
            type="button"
            class="px-2 py-1 border rounded bg-white hover:bg-gray-100"
            aria-label="Agrandir le texte">A+</button
          >
          <a
            id="tab-open-new-tab"
            href="#"
            target="_blank"
            class="px-2 py-1 border rounded bg-white hover:bg-gray-100">Ouvrir ↗</a
          >
          <button
            id="tab-share"
            type="button"
            class="px-2 py-1 border rounded bg-gray-50 hover:bg-gray-100 font-medium text-[#0969da] flex items-center gap-1"
            aria-label="Partager la tablature">Partager</button
          >
          <button
            id="tab-modal-close"
            type="button"
            class="px-2 py-1 border rounded bg-white hover:bg-gray-100"
            aria-label="Fermer">✕</button
          >
        </div>
      </div>

      <div
        class="flex items-center gap-3 border-b border-blue-200 bg-blue-50 p-3 text-blue-700 text-xs shrink-0 landscape:hidden"
      >
        <svg
          class="w-5 h-5 shrink-0 text-blue-600"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="7" y="5" width="10" height="14" rx="1.5" transform="rotate(30 12 12)"></rect>
          <path d="M19 9A7 7 0 0 0 9.5 3.5"></path>
          <polyline points="15 3 19 3 19 7"></polyline>
          <path d="M5 15a7 7 0 0 0 9.5 5.5"></path>
          <polyline points="9 21 5 21 5 17"></polyline>
        </svg>
        <span class="leading-normal font-medium">
          Pour une lecture optimale sans décalages,
          <strong>tournez votre appareil en mode paysage</strong>.
        </span>
      </div>

      <!-- Body -->
      <div id="tab-modal-body" class="overflow-y-auto p-4 w-full flex-1 min-w-0 landscape:p-2">
        <p id="tab-loading" class="text-sm text-gray-500">Chargement...</p>

        <pre
          id="tab-text-content"
          class="hidden w-full max-w-full overflow-x-auto whitespace-pre font-mono leading-relaxed text-gray-900 bg-gray-50 p-3 rounded-md border border-[#d0d7de]"
          style="font-size: 18px; -webkit-overflow-scrolling: touch;">
        </pre>

        <img id="tab-image-content" class="hidden mx-auto max-w-full" alt="" />

        <div id="tab-pdf-container" class="hidden w-full"></div>

        <div id="tab-fallback" class="hidden text-center text-sm text-gray-600">
          <p>Aperçu non disponible pour ce format.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { initTablatures } from "../../scripts/tablatures";
  initTablatures();
</script>
