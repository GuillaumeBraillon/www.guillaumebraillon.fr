---
import RepoIcon from "../components/RepoIcon.astro";
import SkillGroup from "../components/SkillGroup.astro";
import Button from "../components/Button.astro";
import Layout from "../layouts/Layout.astro";
import { profile, skills, experiences, educations } from "../data/cv";
import { contactLinks } from "../data/site";

const profileStatusHref =
  profile.status === "En formation"
    ? "#formation"
    : profile.status === "En poste"
      ? "#experiences"
      : undefined;
---

<Layout title={`CV - ${profile.name}`}>
  <div class="space-y-6">
    <header class="grid gap-4 md:grid-cols-[minmax(0,1fr)_16rem] md:items-stretch">
      <div
        class="gh-card border-l-4 border-l-[#0969da] bg-linear-to-br from-[#f6f8fa] to-white p-5 md:p-6"
      >
        <p class="text-lg font-bold leading-tight tracking-tight text-[#0969da] md:text-xl">
          {profile.title}
        </p>
        <p class="mt-2 text-xs text-[#57606a] font-mono tracking-wide">{profile.subtitle}</p>
        <div class="mt-5 space-y-3 text-[14px] text-[#24292f] leading-relaxed">
          {
            profile.details.map((paragraph) => (
              <p
                class="[&_strong]:font-semibold [&_strong]:text-[#1f2328] [&_a]:font-medium [&_a]:text-[#0969da] [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:text-[#0550ae]"
                set:html={paragraph.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")}
              />
            ))
          }
        </div>
        <div class="mt-5 flex justify-end border-t border-[#d0d7de] pt-4">
          <Button id="download-cv-pdf" variant="primary">Télécharger le CV en PDF</Button>
        </div>
      </div>

      <div class="min-w-0 p-4 gh-surface-muted gh-card space-y-3 text-xs gh-text-muted">
        <div class="grid gap-2">
          <h1 class="text-xl font-semibold text-[#1f2328] tracking-tight">{profile.name}</h1>
          {
            profileStatusHref ? (
              <a
                href={profileStatusHref}
                class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#bfdbfe] bg-[#eff6ff] px-2.5 py-1 text-[11px] font-medium text-[#1d4ed8] transition-colors hover:border-[#93c5fd] hover:bg-[#dbeafe]"
                aria-label={`Voir la rubrique ${profile.status === "En formation" ? "Formation" : "Expériences"}`}
              >
                <span class="h-1.5 w-1.5 rounded-full bg-[#3b82f6]" aria-hidden="true" />
                {profile.status}
              </a>
            ) : (
              <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[#bfdbfe] bg-[#eff6ff] px-2.5 py-1 text-[11px] font-medium text-[#1d4ed8]">
                <span class="h-1.5 w-1.5 rounded-full bg-[#3b82f6]" aria-hidden="true" />
                {profile.status}
              </span>
            )
          }
          {
            contactLinks.map((link) => (
              <a
                href={link.href}
                target={link.href.startsWith("mailto:") ? undefined : "_blank"}
                rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                class="group flex min-w-0 items-center gap-2 overflow-hidden rounded-md border border-[#d0d7de] bg-white px-2.5 py-2 transition-colors hover:border-[#0969da] hover:bg-[#ddf4ff]"
              >
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-[#f6f8fa] text-[#636c76] transition-colors group-hover:bg-white group-hover:text-[#0969da]">
                  <RepoIcon name={link.icon} />
                </span>
                <span class="min-w-0">
                  <span class="block text-[11px] font-semibold uppercase tracking-wider gh-text">
                    {link.label}
                  </span>
                  <span class="block truncate font-mono text-[12px] gh-link">{link.value}</span>
                </span>
              </a>
            ))
          }
        </div>
        <div class="flex flex-wrap gap-2 border-t border-[#d0d7de] pt-3">
          <span
            class="inline-flex items-center gap-1.5 rounded-md border border-[#d0d7de] bg-white px-2.5 py-1.5 text-[11px]"
          >
            <span class="font-semibold text-[#57606a]">Permis</span>
            <span class="font-mono text-[#1f2328]">B</span>
          </span>
          <span
            class="inline-flex min-w-0 items-center gap-1.5 rounded-md border border-[#d0d7de] bg-white px-2.5 py-1.5 text-[11px]"
          >
            <span class="font-semibold text-[#57606a]">Langue</span>
            <span class="truncate text-[#1f2328]">{profile.lang}</span>
          </span>
        </div>
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-6">
      <div class="space-y-6">
        <section id="experiences" class="scroll-mt-6">
          <h2
            class="mb-4 border-l-4 border-[#0969da] py-1 pl-3 text-base font-bold tracking-tight text-[#1f2328]"
          >
            Expériences Professionnelles
          </h2>
          <div class="space-y-4">
            {
              experiences.map((exp) => (
                <div class="gh-card p-4 hover:border-[#0969da] transition-colors group">
                  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-1">
                    <div>
                      <h3 class="text-[14px] font-semibold gh-text">{exp.role}</h3>
                      <p class="text-xs font-medium gh-link mt-0.5">{exp.company}</p>
                    </div>
                    <span class="gh-badge gh-badge--count text-[11px] font-mono sm:shrink-0 whitespace-nowrap self-start sm:self-auto">
                      {exp.period}
                    </span>
                  </div>
                  <p class="mt-3 text-[13px] gh-text-muted leading-normal">{exp.description}</p>
                </div>
              ))
            }
          </div>
        </section>

        <section id="formation" class="scroll-mt-6">
          <h2
            class="mb-4 border-l-4 border-[#0969da] py-1 pl-3 text-base font-bold tracking-tight text-[#1f2328]"
          >
            Formation & Certifications
          </h2>
          <div class="grid gap-3 sm:grid-cols-2">
            {
              educations.map((edu) => (
                <div class="gh-card p-3.5 flex flex-col justify-between">
                  <div>
                    <div class="flex items-start justify-between gap-2">
                      <h3 class="text-[13px] font-semibold gh-text leading-tight">{edu.title}</h3>
                      <span class="gh-badge gh-badge--date text-[10px] font-mono font-medium">
                        {edu.year}
                      </span>
                    </div>
                    <p class="text-xs gh-link font-medium mt-0.5">{edu.institution}</p>
                    <p class="mt-2 text-[12px] gh-text-muted leading-normal">{edu.details}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </section>
      </div>

      <div class="space-y-4">
        <h2
          class="border-l-4 border-[#0969da] py-1 pl-3 text-base font-bold tracking-tight text-[#1f2328]"
        >
          Compétences Techniques
        </h2>

        <SkillGroup title="Intelligence Artificielle" skills={skills.iaAuto} tone="success" />

        <SkillGroup title="Outils de développement IA" skills={skills.aiDevTools} tone="muted" />

        <SkillGroup title="Automatisation & IoT" skills={skills.automation} tone="success" />

        <SkillGroup title="Frontend" skills={skills.frontend} tone="info" />

        <SkillGroup title="Backend" skills={skills.backend} tone="info" />

        <SkillGroup title="Bases de données" skills={skills.database} tone="mono" />

        <SkillGroup title="DevOps & Outils" skills={skills.devops} tone="muted" />

        <div
          class="p-3 bg-[#fff8c5] border border-[#rgba(191,133,0,0.3)] rounded-md text-xs text-[#735c0f]"
        >
          <strong>Hobbies & Intérêts :</strong> Domotique (Home Assistant), Guitare, Photographie & Vidéo,
          Voyages (Australie, Irlande).
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import "../scripts/export-cv-pdf";
</script>
