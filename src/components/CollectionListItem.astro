---
import { Image } from "astro:assets";
import RepoIcon from "./RepoIcon.astro";

interface Props {
  href: string;
  title: string;
  description?: string;
  thumbnail?: ImageMetadata;
  thumbnailAlt?: string;
  wrapperClass?: string;
}

const {
  href,
  title,
  description,
  thumbnail,
  thumbnailAlt = title,
  wrapperClass = "",
} = Astro.props as Props;
---

<div class={`py-4 flex flex-col sm:flex-row sm:items-start gap-4 ${wrapperClass}`.trim()}>
  {
    thumbnail && (
      <Image
        src={thumbnail}
        alt={thumbnailAlt}
        class="w-24 h-24 object-cover rounded"
        loading="lazy"
      />
    )
  }

  <div class="space-y-1 w-full min-w-0">
    <div class="flex items-center gap-2 min-w-0 flex-wrap">
      <a
        href={href}
        class="text-lg font-semibold text-[#0969da] hover:underline flex items-center gap-2 min-w-0"
      >
        <span class="truncate">{title}</span>
      </a>
      <slot name="titleBadge" />
    </div>

    {description && <p class="text-[14px] text-[#57606a] leading-normal">{description}</p>}

    <div class="mt-3 text-[12px] text-[#636c76] flex flex-wrap items-center gap-1.5">
      <slot name="meta" />
    </div>
  </div>
</div>
