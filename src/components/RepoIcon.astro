const icon = icons[name];
---

<svg
  class={`inline-block ${className}`.trim()}
  viewBox="0 0 16 16"
  width={size}
  height={size}
  fill={icon.fill}
  stroke={icon.stroke}
  stroke-width={icon.stroke === "none" ? undefined : "1.4"}
  stroke-linecap={icon.stroke === "none" ? undefined : "round"}
  stroke-linejoin={icon.stroke === "none" ? undefined : "round"}
  aria-hidden="true"
>
  {icon.paths.map((path) => <path d={path} />)}
</svg>
