{
  "name": "guillaumebraillon-fr---astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bash -lc 'source \"$NVM_DIR/nvm.sh\" && nvm use >/dev/null && astro dev --host'",
    "build": "astro build",
    "fix": "npm run format && npm run lint:fix && npm run tsc && npm run check",
    "generate-tablatures": "node src/scripts/generate-tablatures.js",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "^7.2.9",
    "dompurify": "^3.4.12",
    "leaflet": "^1.9.4",
    "marked": "^18.0.5",
    "medium-zoom": "^1.1.0",
    "rehype-external-links": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.21",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-prettier": "^5.5.6",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
